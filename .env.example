# Case-study password protection
# Provide either a single password...
CASE_STUDY_PASSWORD=

# ...or a comma-separated list.
# CASE_STUDY_PASSWORDS=password-one,password-two

# Optional but recommended: explicit signing secret used for access tokens.
# If omitted, the app derives a signing key from your configured password(s).
# Generate one with `openssl rand -base64 32`
CASE_STUDY_AUTH_SECRET=
